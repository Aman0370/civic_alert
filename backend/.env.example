# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/civicalert
# Or individual params if you prefer:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civicalert
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10

# Email (for OTP verification) - use a Gmail app password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="CivicAlert <no-reply@civicalert.app>"

# Media storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Authority registration - a shared secret authorities must provide to self-register
# (in production, authority accounts should be provisioned by an admin instead)
AUTHORITY_SIGNUP_CODE=change_this_secret_code
